[Custom Commands][net.local.brave-2.desktop]
Exec=brave --profile-directory="Profile 1" "https://notebooklm.google.com/"
Name=Notebook LM

[Custom Commands][net.local.brave-3.desktop]
Exec=brave --profile-directory="Profile 1" "https://chatgpt.com/"
Name=ChatGPT

[Custom Commands][net.local.brave-4.desktop]
Exec=brave --profile-directory="Default" "https://chatgpt.com/"
Name=ChatGPT noacc

[Custom Commands][net.local.brave.desktop]
Exec=brave --profile-directory="Profile 1" "https://gemini.google.com/"
Name=Gemini

[Custom Commands][net.local.firefox.desktop]
Exec=firefox -P "default" "https://chatgpt.com/"
Name=ChatGPT firefox

[Custom Commands][net.local.kwriteconfig6-2.desktop]
Exec=kwriteconfig6 --file kwinrc --group Plugins --key karouselEnabled true
Name=enable_karousel

[Custom Commands][net.local.kwriteconfig6.desktop]
Exec=kwriteconfig6 --file kwinrc --group Plugins --key karouselEnabled false
Name=disable_karousel

[Custom Commands][net.local.toggle_karousel.sh.desktop]
Exec=/home/milord/toggle_karousel.sh
Name=toggle_karousel

[Custom Commands][net.local.toggle_panel.sh.desktop]
Exec=/home/milord/toggle_panel.sh
Name=toggle_panel

